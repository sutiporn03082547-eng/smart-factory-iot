# =========================================================
#  Smart Factory - ค่าตั้งค่าทั้งระบบ
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าที่มีคำว่า CHANGE_ME
#  ห้ามอัปโหลดไฟล์ .env ขึ้น GitHub (มีอยู่ใน .gitignore แล้ว)
# =========================================================

# ---------- InfluxDB (W11) ----------
INFLUX_USER=admin
INFLUX_PASSWORD=admin1234
INFLUX_ORG=factory
INFLUX_BUCKET=machines
# โทเคนตั้งเองได้ (ยาวๆ สุ่มๆ) ทุก service จะใช้ค่านี้ร่วมกัน
INFLUX_TOKEN=smartfactory-super-secret-token-CHANGE_ME

# ---------- Grafana (W8, W11) ----------
GRAFANA_ADMIN_PASSWORD=admin1234

# ---------- Telegram (W11) ----------
# ได้จาก @BotFather
TELEGRAM_BOT_TOKEN=CHANGE_ME
# chat id ของคุณหรือกลุ่ม (กลุ่มขึ้นต้นด้วย -100...)
TELEGRAM_CHAT_ID=CHANGE_ME
# chat id ที่อนุญาตให้สั่งงานเครื่องจักรได้ (คั่นด้วย ,) ปล่อยว่าง = เท่ากับ TELEGRAM_CHAT_ID
TELEGRAM_ALLOWED=

# ---------- Google (W10) ----------
# URL ของ Apps Script Web App (ลงท้ายด้วย /exec)
SHEETS_URL=https://script.google.com/macros/s/CHANGE_ME/exec
# ลิงก์ Google Form แบบ pre-filled ให้แทนชื่อเครื่องด้วย {machine}
# ตัวอย่าง: https://docs.google.com/forms/d/e/XXXX/viewform?usp=pp_url&entry.123456={machine}
FORM_PREFILL_URL=https://docs.google.com/forms/d/e/CHANGE_ME/viewform?usp=pp_url&entry.0={machine}

# ---------- n8n + AI (W12) ----------
# ใช้ API แบบ OpenAI-compatible ได้ทุกเจ้า (OpenAI / DeepSeek / Groq / Gemini OpenAI endpoint)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=CHANGE_ME
TZ=Asia/Bangkok

# ---------- Wokwi ESP32 (เครื่อง M6) ----------
# prefix ต้องไม่ซ้ำคนอื่นบน public broker ใช้รหัสนักศึกษาได้
HIVEMQ_PREFIX=smf-CHANGE_ME
HIVEMQ_DATA_TOPIC=smf-CHANGE_ME/factory/data/+

# ---------- Node-RED Command API (/api/cmd) ----------
# ตั้งค่าเมื่อเปิด Port Forwarding เพื่อกันคนอื่นสั่งเครื่อง (ต้องส่ง &key=... ด้วย)
CMD_API_KEY=

# ---------- Simulator ----------
TICK_SEC=2
# โอกาสเครื่องเสียเองต่อรอบ (0 = เสียเฉพาะตอนสั่งจาก Telegram)
FAULT_PROB=0.0005
# ความเร็วที่ความเสียหายลุกลาม (1.5 = ลูกปืนสึกจน Trip ~1.5 นาที เหมาะกับเดโม)
FAULT_SPEED=1.5
