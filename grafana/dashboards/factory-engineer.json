        "name": "machine",
        "label": "เครื่องจักร",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-factory"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"machines\", tag: \"machine\")",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"machines\", tag: \"machine\")",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
