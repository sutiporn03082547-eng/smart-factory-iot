          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-factory"
          },
          "query": "from(bucket: \"machines\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"machine\" and r._field == \"temp\" and r.machine =~ /^${machine:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"machine\"])"
        }
