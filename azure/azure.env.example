# ค่าตั้งค่าสำหรับ Azure VM  ->  cp azure.env.example azure.env  แล้วแก้
# Network ID จาก https://my.zerotier.com
ZT_NETWORK_ID=CHANGE_ME
# ZeroTier IP ของคอมที่บ้าน (Windows) ที่รัน InfluxDB
HOME_ZT_IP=10.147.17.10
# Public IP หรือ DNS name ของ Azure VM
AZURE_PUBLIC=CHANGE_ME
# DDNS ของ Router ที่บ้าน + port ที่ forward เข้า Node-RED (W9)
NODERED_STATUS_API=http://CHANGE_ME.thddns.net:1880/api/status

INFLUX_ORG=factory
INFLUX_BUCKET=machines
INFLUX_TOKEN=smartfactory-super-secret-token-CHANGE_ME

GRAFANA_ADMIN_PASSWORD=ChangeMe-Admin-123
GRAFANA_VIEWER_USER=viewer
GRAFANA_VIEWER_PASSWORD=Viewer-1234

FORM_URL=https://forms.gle/CHANGE_ME
MYMAPS_URL=https://www.google.com/maps/d/CHANGE_ME
SHEET_URL=https://docs.google.com/spreadsheets/d/CHANGE_ME
TELEGRAM_URL=https://t.me/CHANGE_ME_bot
GITHUB_URL=https://github.com/CHANGE_ME/smart-factory
